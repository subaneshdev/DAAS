# Canonical production origin. No trailing slash. Rebuild after changing it.
NEXT_PUBLIC_SITE_URL=https://daas.media
# Optional direct form delivery. Without BOTH settings the form prepares an email draft.
# Keep these server-only. Verify the sender domain with Resend before enabling.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
# Set to 1 on staging/preview deployments to emit noindex and disallow crawling.
PREVIEW_NOINDEX=
